# Copy this file to .env and fill in the paths for your machine.
# .env is gitignored and will not be committed.

# Path to the COMFORT SQLite database
COMFORT_DB_PATH=/path/to/comfort.sqlite

# Path to a GEBCO bathymetry NetCDF file (needed for gridding examples)
COMFORT_BATHYMETRY_PATH=/path/to/gebco_bathymetry.nc

# Path to the Longhurst provinces shapefile (https://www.marineregions.org/downloads.php, optional for 04_water_masses.py)
LONGHURST_SHP_PATH=/path/to/longhurst.shp

# Path to the Jenniges provinces CSV (https://zenodo.org/records/15201767, optional for 04_water_masses.py)
JENNIGES_CSV_PATH=/path/to/cluster_set.csv
